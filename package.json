{
  "name": "@wireface/sdk",
  "version": "0.3.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Free offline face animation and local character creation from photos, with hosted AI detection for drawn and stylised faces.",
  "homepage": "https://wireface.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/compsmart/wireface-sdk.git"
  },
  "bugs": "https://github.com/compsmart/wireface-sdk/issues",
  "type": "module",
  "main": "./dist/wireface.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/wireface.js"
    },
    "./config": {
      "types": "./types/config.d.ts",
      "default": "./dist/config.js"
    },
    "./2d": {
      "types": "./types/2d.d.ts",
      "default": "./dist/2d.js"
    },
    "./2d/live": {
      "types": "./types/2d-live.d.ts",
      "default": "./dist/2d-live.js"
    },
    "./2d/config": {
      "types": "./types/2d-config.d.ts",
      "default": "./dist/2d-config.js"
    },
    "./three": {
      "types": "./types/three.d.ts",
      "default": "./dist/three.js"
    },
    "./three/characters": {
      "types": "./types/three-characters.d.ts",
      "default": "./dist/three-characters.js"
    },
    "./three/kit": {
      "types": "./types/three-kit.d.ts",
      "default": "./dist/three-kit.js"
    },
    "./assets/*": "./assets/*",
    "./face.schema.json": "./face.schema.json",
    "./face2d.schema.json": "./face2d.schema.json",
    "./package.json": "./package.json",
    "./rigging": {
      "types": "./types/rigging.d.ts",
      "default": "./dist/rigging.js"
    },
    "./create": {
      "types": "./types/create.d.ts",
      "default": "./dist/create.js"
    },
    "./character.schema.json": "./schemas/character.schema.json",
    "./images": {
      "types": "./types/images.d.ts",
      "default": "./dist/images.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "types",
    "face.schema.json",
    "face2d.schema.json",
    "README.md",
    "LICENSE.md",
    "NOTICE",
    "licenses",
    "schemas",
    "openapi.json",
    "HOSTED-RIGGING-TERMS.md"
  ],
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "scripts": {
    "start": "node examples/hosted/backend.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "face",
    "avatar",
    "talking-head",
    "lip-sync",
    "webgl",
    "three",
    "agent",
    "voice"
  ],
  "devDependencies": {
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  }
}
