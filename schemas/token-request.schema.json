{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wireface.dev/schema/token-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "origin"
  ],
  "properties": {
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "rig:2d",
          "rig:3d"
        ]
      }
    },
    "origin": {
      "type": "string",
      "format": "uri"
    }
  }
}
