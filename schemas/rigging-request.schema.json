{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wireface.dev/schema/rigging-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image"
  ],
  "properties": {
    "image": {
      "type": "string",
      "maxLength": 17825792,
      "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$"
    },
    "name": {
      "type": "string",
      "maxLength": 200,
      "default": "Your character"
    },
    "teeth": {
      "enum": [
        "normal",
        "braces",
        "vampire",
        "turkey",
        "sharp",
        "goofy",
        "anime",
        "cartoon",
        "clay",
        "comic",
        "pixel",
        "sketch"
      ]
    }
  }
}
