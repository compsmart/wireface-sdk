{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wireface.dev/schema/job.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "status",
    "stage",
    "requestId",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "kind": {
      "enum": [
        "2d",
        "3d"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "processing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "stage": {
      "enum": [
        "queued",
        "preparing",
        "anchors",
        "landmarks",
        "fitting",
        "validating",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "requestId": {
      "type": "string"
    },
    "createdAt": {
      "type": "integer"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "character": {
      "$ref": "character.schema.json"
    }
  }
}
