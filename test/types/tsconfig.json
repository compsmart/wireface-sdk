{
  // Type-checks the hand-written declarations in types/ and a file that uses every entry the way the guides do.
  // Run from the package folder: npx tsc -p test/types
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["*.ts", "../../types/*.d.ts"]
}
